{
  "name": "geo-ne-admin1",
  "title": "Natural Earth Admin1 Polygons as GeoJSON",
  "version": "0.1.0",
  "description": "Geodata package providing GeoJSON polygons for first-order administrative subdivisions worldwide.",
  "repository": {
    "type": "git",
    "url": "git://github.com/datasets/geo-ne-admin1.git"
  },
  "sources": [
    {
      "name": "Natural Earth",
      "path": "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_1_states_provinces.geojson",
      "title": "Natural Earth"
    }
  ],
  "keywords": [
    "geodata",
    "vector",
    "country"
  ],
  "licenses": [
    {
      "name": "ODC-PDDL-1.0",
      "path": "http://opendatacommons.org/licenses/pddl/",
      "title": "Open Data Commons Public Domain Dedication and License v1.0"
    }
  ],
  "resources": [
    {
      "name": "admin1",
      "path": "data/admin1.geojson",
      "format": "geojson",
      "mediatype": "application/json",
        "schema": {
          "fields": [
            {
              "name": "name",
              "description": "Common name of the administrative subdivision",
              "type": "string"
            },
            {
              "name": "admin",
              "description": "Country name",
              "type": "string"
            },
            {
              "name": "iso_3166_2",
              "description": "ISO 3166-2 subdivision code",
              "type": "string"
            },
            {
              "name": "adm0_a3",
              "description": "ISO 3166-1 alpha-3 country code",
              "type": "string"
            }
          ]
        }
    }
  ],
  "homepage": "http://github.com/datasets/geo-ne-admin1",
  "collection": "geojson"
}
